# Bags API Key — get yours free at https://dev.bags.fm
NEXT_PUBLIC_BAGS_API_KEY=

# Default wallet for claim tx (optional, users can enter in the UI)
NEXT_PUBLIC_DEFAULT_WALLET=

# Solana RPC (optional — defaults to mainnet-beta public)
# Get a free Helius RPC at https://helius.dev for better reliability
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
